# ==============================================================================
# SentinelFL Frontend Environment Configuration
# ==============================================================================

# FastAPI Backend URL (Local development or remote production gateway)
# When deploying unified containers, can be left blank to default to window.location.origin
VITE_API_BASE_URL=http://localhost:8000

# Supabase Project Configuration (Client-Safe Publishable Credentials)
# Obtain from Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key_here
