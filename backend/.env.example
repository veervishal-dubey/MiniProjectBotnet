# ==============================================================================
# SentinelFL Backend Environment Variables
# NEVER commit the actual .env file with real secrets to version control.
# ==============================================================================

# Supabase Project Configuration
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key (CONFIDENTIAL - BACKEND ONLY)
# Never expose this key to client-side code or public repositories.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase Anon / Publishable Key
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Storage Bucket for Datasets (Private)
STORAGE_BUCKET_NAME=sentinelfl-datasets

# Allowed CORS Origins (comma-separated list of frontend URLs)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174

# Application Environment (development, testing, production)
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000
